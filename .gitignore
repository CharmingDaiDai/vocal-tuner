# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
*.whl

# 虚拟环境（不提交 conda/venv 环境本体）
.venv/
venv/
env/
ENV/
.conda/

# ── 测试 / 覆盖率 ────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.tox/
.nox/

# ── 类型检查 / Lint ──────────────────────────────────────
.mypy_cache/
.dmypy.json
.pytype/
.ruff_cache/

# ── 操作系统 ─────────────────────────────────────────────
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~

# ── 编辑器 / IDE ─────────────────────────────────────────
.idea/
*.swp
*.swo
*.swn
*.sublime-project
*.sublime-workspace

# VS Code（保留 settings/extensions 共享，忽略本地覆盖）
.vscode/launch.json
.vscode/tasks.json
.vscode/*.log

# ── 日志 & 临时文件 ──────────────────────────────────────
*.log
*.tmp
*.temp
*.bak
*.orig

# ── 音频 & 数据导出 ──────────────────────────────────────
# 不提交录制的原始音频或临时导出
*.wav
*.mp3
*.flac
*.ogg
*.m4a
pitch-session-*.csv

# ── 项目特定 ─────────────────────────────────────────────
# sounddevice / PortAudio 不生成额外文件，无需排除
# librosa 缓存（numba JIT 缓存存入 __pycache__，已覆盖）
backend/uploads/*
frontend-react/node_modules
# 环境快照不忽略（environment.yml 应提交，方便复现环境）
# environment.yml  ← 故意不忽略


.vscode
.claude